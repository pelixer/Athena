# Cloudflare 정적 자산 응답 헤더 (Workers 정적 자산이 이 파일을 읽는다). valopoint와 같은 틀.
#
# CSP에서 'self' 밖으로 여는 것과 이유:
#   script-src 'wasm-unsafe-eval'           기기 안 OCR(Tesseract) 엔진이 WebAssembly
#   style-src/font-src Google Fonts         Noto Serif KR
#   img-src/connect-src blob: data:         저장된 사진(blob:)을 화면에 띄우고, 카드 이미지로 그릴 때 다시 읽는다
#   connect-src Google Fonts                카드 이미지에 글꼴을 넣으려고 글꼴 파일을 읽는다
#   media-src blob: mediastream:            카메라 뷰파인더

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# OCR 엔진·한국어 모델 (약 5MB). 패키지를 올리면 이름은 같고 내용만 바뀌므로 길게 두되 immutable은 아니다
/ocr/*
  Cache-Control: public, max-age=2592000

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), geolocation=(self), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' data: blob: https://fonts.googleapis.com https://fonts.gstatic.com; media-src 'self' blob: mediastream:; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
